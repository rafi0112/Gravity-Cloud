# GravityCloud — Single source of truth for Tailscale / edge configuration
#
# Single-PC mode (default):
#   EDGE_NODE_2_URL=
#
# Two-PC mode (add PC-2 via Tailscale):
#   EDGE_NODE_2_URL=http://100.x.x.x:8001
#
# Change ONLY this file to switch between modes.
# DO NOT put Tailscale IPs in any Python/JS/YAML source file.

LOCAL_OLLAMA_SERVICE_URL=http://ollama-service:8001
